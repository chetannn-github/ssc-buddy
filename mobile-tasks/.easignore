# Only source, configuration, and runtime assets belong in the EAS upload.
# Dependencies are installed by EAS from package.json/pnpm-lock.yaml.
node_modules/
.pnpm/
.expo/
.expo-shared/

# Local/native build output is never needed by the remote builder.
android/
ios/
dist/
web-build/
coverage/
build/
.cache/

# Repository/editor artefacts.
.git/
*.log
*.tsbuildinfo
*.map
.DS_Store

# Keep assets/, src/, plugins/, app.json, eas.json, package.json,
# pnpm-lock.yaml, and environment configuration available to EAS.
