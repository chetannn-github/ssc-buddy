{
  "expo": {
    "name": "SSC Buddy",
    "slug": "huijppop",
    "scheme": "sscbuddy",
    "version": "1.0.0",
    "icon": "./assets/auth.png",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "androidStatusBar": {
      "hidden": true,
      "backgroundColor": "#000000",
      "barStyle": "light-content"
    },
    "android": {
      "package": "com.sscbuddy.tasks",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.sscbuddy.tasks"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/auth.jpg",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": true
        }
      ],
      "./plugins/with-unlock-quiz-receiver",
      "./plugins/with-timer-widget-shortcut",
      [
        "react-native-android-widget",
        {
          "widgets": [
            { "name": "HabitWidget", "label": "Habit Heatmap", "description": "Habit heatmap with monthly or 20-week history and streak", "minWidth": "140dp", "minResizeWidth": "140dp", "minHeight": "170dp", "targetCellWidth": 2, "targetCellHeight": 2, "resizeMode": "horizontal|vertical", "updatePeriodMillis": 1800000, "widgetFeatures": "reconfigurable" },
            { "name": "HabitMonthWidget", "label": "Habit Month", "description": "Monthly habit calendar and streak", "minWidth": "140dp", "minResizeWidth": "140dp", "minHeight": "170dp", "targetCellWidth": 2, "targetCellHeight": 2, "resizeMode": "horizontal|vertical", "updatePeriodMillis": 1800000, "widgetFeatures": "reconfigurable" },
            { "name": "HabitCompactWidget", "label": "Habit Compact", "description": "Compact habit name, streak and mark button", "minWidth": "110dp", "minHeight": "140dp", "targetCellWidth": 2, "targetCellHeight": 2, "resizeMode": "horizontal|vertical", "updatePeriodMillis": 1800000, "widgetFeatures": "reconfigurable" },
            { "name": "TimerWidget", "label": "Timer", "description": "Countdown for an important date", "minWidth": "160dp", "minHeight": "150dp", "targetCellWidth": 2, "targetCellHeight": 2, "resizeMode": "horizontal|vertical", "updatePeriodMillis": 1800000, "widgetFeatures": "reconfigurable" },
            {
              "name": "DailyTasksWidget",
              "label": "Daily tasks",
              "description": "Today's SSC Buddy tasks and completion progress",
              "minWidth": "360dp",
              "minHeight": "300dp",
              "targetCellWidth": 4,
              "targetCellHeight": 5,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "QuickRecallWidget",
              "label": "Quick recall",
              "description": "Three focused SSC questions when you unlock your phone",
              "minWidth": "360dp",
              "minHeight": "360dp",
              "targetCellWidth": 4,
              "targetCellHeight": 6,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      "expo-asset",
      "expo-notifications"
    ],
    "extra": {
      "eas": {
        "projectId": "8a2463ba-e253-446c-9ba8-2d7fd9ef9313"
      }
    },
    "owner": "vghjhjms-team"
  }
}
