{
  "expo": {
    "name": "SSC Buddy",
    "slug": "ssc-buddy-tasks",
    "scheme": "sscbuddy",
    "version": "1.0.0",
    "icon": "./assets/auth.jpg",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "androidStatusBar": {
      "hidden": true
    },
    "android": {
      "package": "com.sscbuddy.tasks",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.sscbuddy.tasks"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/auth.jpg",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": true
        }
      ],
      "./plugins/with-unlock-quiz-receiver",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "DailyTasksWidget",
              "label": "Daily tasks",
              "description": "Today's SSC Buddy tasks and completion progress",
              "minWidth": "360dp",
              "minHeight": "300dp",
              "targetCellWidth": 4,
              "targetCellHeight": 5,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "QuickRecallWidget",
              "label": "Quick recall",
              "description": "Three focused SSC questions when you unlock your phone",
              "minWidth": "360dp",
                "minHeight": "360dp",
              "targetCellWidth": 4,
                "targetCellHeight": 6,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "f27fd9ce-a2c6-47cd-977a-2b3d690595ac"
      }
    }
  }
}
