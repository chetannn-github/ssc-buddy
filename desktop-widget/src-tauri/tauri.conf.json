{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SSC Buddy Widget",
  "version": "1.0.0",
  "identifier": "com.sscbuddy.tasks.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev:web",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "visible": false,
        "title": "SSC Buddy Widget",
        "width": 400,
        "height": 475,
        "minWidth": 350,
        "minHeight": 360,
        "maxWidth": 520,
        "maxHeight": 700,
        "alwaysOnTop": false,
        "alwaysOnBottom": true,
        "resizable": true,
        "maximizable": false,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "skipTaskbar": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "targets": ["nsis"],
    "windows": {
      "nsis": {
        "displayLanguageSelector": false,
        "installerHooks": "installer-hooks.nsh",
        "sidebarImage": "icons/installer-sidebar.bmp",
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
